<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="[1.22.0]" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="[1.0.14]" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="[10.0.12]" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\agent-pack\prepared\**\*"
             Link="agent-pack\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
